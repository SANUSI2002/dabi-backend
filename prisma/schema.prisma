// authorized verification; a dated, audited test exception may temporarily
// accept verified evidence in quarantine without labeling it clean.
model PlatformApplicationEvidence {
  id String @id @default(uuid())
  applicationId String @map("application_id")
  requirementKey String @map("requirement_key")
  fileName String @map("file_name")
  contentType String @map("content_type")
  sizeBytes Int @map("size_bytes")
  sha256 String
  storageKey String @map("storage_key")
  storageBucket String @default("sabi-hospital-evidence-quarantine") @map("storage_bucket")
  scanStatus String @default("PENDING") @map("scan_status")
  scanLeaseToken String? @map("scan_lease_token")
  scanLeaseExpiresAt DateTime? @map("scan_lease_expires_at")
  scanAttempts Int @default(0) @map("scan_attempts")
  scanErrorCode String? @map("scan_error_code")
  scannerVersion String? @map("scanner_version")
  scannedAt DateTime? @map("scanned_at")
  unscannedDownloadedByUserId String? @map("unscanned_downloaded_by_user_id")
  unscannedDownloadedAt DateTime? @map("unscanned_downloaded_at")
  unscannedExceptionByUserId String? @map("unscanned_exception_by_user_id")
  unscannedExceptionAt DateTime? @map("unscanned_exception_at")
  unscannedExceptionNote String? @map("unscanned_exception_note")
  reviewStatus String @default("PENDING") @map("review_status")
  reviewedByUserId String? @map("reviewed_by_user_id")
  reviewedAt DateTime? @map("reviewed_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  application PlatformApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  events PlatformApplicationEvidenceEvent[]

  @@index([applicationId, requirementKey, createdAt])
