enum OrganisationType {
  HOSPITAL
  CLINIC
  LABORATORY
  DIAGNOSTIC_CENTRE
  OTHER
}

enum OrganisationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

model Organisation {
  id String @id @default(uuid())
  ownerId String @unique @map("owner_id")
  type OrganisationType
  name String
  address String
  country String
  state String
  city String
  contactEmail String @map("contact_email")
  contactPhone String @map("contact_phone")
  status OrganisationStatus @default(PENDING)
  decisionNote String? @map("decision_note")
  decidedByUserId String? @map("decided_by_user_id")
  decidedAt DateTime? @map("decided_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  onboarding OrganisationSubmission?
  memberPlans HospitalMemberPlan[]
  identityOrganization IdentityOrganization?

  @@index([status, type])
  @@map("organisations")
}

// Authentication scopes link existing facility records without replacing their
// established onboarding, compliance or commercial data.
model IdentityOrganization {
  id String @id @default(uuid())
  type IdentityOrganizationType
  organisationId String? @unique @map("organisation_id")
  pharmacyId String? @unique @map("pharmacy_id")
  createdAt DateTime @default(now()) @map("created_at")
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  memberships OrganizationMembership[]
  invitations IdentityInvitation[]

  @@map("identity_organizations")
}

model OrganizationMembership {
  id String @id @default(uuid())
  userId String @map("user_id")
  organizationId String @map("organization_id")
  status IdentityMembershipStatus @default(PENDING)
  joinedAt DateTime? @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization IdentityOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
  @@map("organization_memberships")
}

model AccessRole {
  code String @id
  scope AccessRoleScope
  description String?
  permissions AccessRolePermission[]
  membershipRoles MembershipRole[]
  platformAssignments PlatformRoleAssignment[]

  @@map("access_roles")
}

model AccessPermission {
  code String @id
  description String?
  roles AccessRolePermission[]

  @@map("access_permissions")
}

model AccessRolePermission {
  roleCode String @map("role_code")
  permissionCode String @map("permission_code")
  role AccessRole @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission AccessPermission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("access_role_permissions")
}

model MembershipRole {
  membershipId String @map("membership_id")
  roleCode String @map("role_code")
  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([membershipId, roleCode])
  @@map("membership_roles")
}

model PlatformRoleAssignment {
  userId String @map("user_id")
  roleCode String @map("role_code")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AccessRole @relation(fields: [roleCode], references: [code], onDelete: Restrict)

  @@id([userId, roleCode])
  @@map("platform_role_assignments")
}

// Pharmacy keeps its existing owner, role and compliance status. This contains
// only extra onboarding evidence for the live organisation form.
model OrganisationSubmission {
  id String @id @default(uuid())
  organisationId String? @unique @map("organisation_id")
  pharmacyId String? @unique @map("pharmacy_id")
  details Json
  termsAcceptedAt DateTime @map("terms_accepted_at")
  privacyAcceptedAt DateTime @map("privacy_accepted_at")
  healthDataAcceptedAt DateTime? @map("health_data_accepted_at")
  consentVersion String @default("1.0") @map("consent_version")
  createdAt DateTime @default(now()) @map("created_at")
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  documents OrganisationDocument[]

  @@map("organisation_submissions")
}

// Commercial offers are authored as drafts and become public only after an
// explicit publish action. Historical versions are never edited in place.
model PlatformPackage {
  id String @id @default(uuid())
  code String @unique
  name String
  description String
  recommended Boolean @default(false)
  active Boolean @default(true)
  branchLimit Int @default(1) @map("branch_limit")
  storageLimitGb Int @default(10) @map("storage_limit_gb")
  supportLevel String @default("STANDARD") @map("support_level")
  publishedVersion Int? @map("published_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versions PlatformPackageVersion[]
  applications PlatformApplication[]

  @@map("platform_packages")
}

model PlatformPackageVersion {
  id String @id @default(uuid())
  packageId String @map("package_id")
  version Int
  status String @default("DRAFT")
  currency String @default("NGN")
  monthlyPriceMinor Int @map("monthly_price_minor")
  annualPriceMinor Int @map("annual_price_minor")
  moduleKeys String[] @default([]) @map("module_keys")
  createdByUserId String @map("created_by_user_id")
  createdAt DateTime @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  package PlatformPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  applications PlatformApplication[]

  @@unique([packageId, version])
  @@index([packageId, status])
  @@map("platform_package_versions")
}

// An application is deliberately NOT an IdentityOrganization or a tenant.
// Email possession is required before it enters the review queue.
model PlatformApplication {
  id String @id @default(uuid())
  clientDraftId String @unique @map("client_draft_id")
  requestHash String @map("request_hash")
  reference String @unique
  ownerEmail String @map("owner_email")
  organizationName String @map("organization_name")
  status String @default("AWAITING_EMAIL")
  details Json
  packageId String @map("package_id")
  packageVersionId String @map("package_version_id")
  billingCycle String @map("billing_cycle")
  verificationTokenHash String? @unique @map("verification_token_hash")
  verificationExpiresAt DateTime? @map("verification_expires_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  submittedAt DateTime? @map("submitted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  package PlatformPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  packageVersion PlatformPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([ownerEmail, createdAt])
  @@map("platform_applications")
}

model OrganisationDocument {
  id String @id @default(uuid())
  submissionId String @map("submission_id")
  key String
  name String
  contentType String @map("content_type")
  content Bytes
  submission OrganisationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, key])
  @@map("organisation_documents")
}


enum HospitalMemberPlanStatus {
  ACTIVE
  ARCHIVED
}

model HospitalMemberPlan {
  id String @id @default(uuid())
  hospitalId String @map("hospital_id")
  name String
  description String?
  feeMinor Int @map("fee_minor")
  status HospitalMemberPlanStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  hospital Organisation @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId, status, createdAt])
  @@map("hospital_member_plans")
}
