DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-token-secret"
ACCESS_TOKEN_EXPIRY="15m"
JWT_ISSUER="sabi-identity"
JWT_AUDIENCE="sabi-api"
REFRESH_TOKEN_EXPIRY="7d"
# Phase 3 browser sessions. Production requires HTTPS and a common registrable
# domain for the API and all four app subdomains. Do not use a Vercel preview
# domain as AUTH_COOKIE_DOMAIN.
SESSION_DAYS="7"
SESSION_MAX_DAYS="90"
AUTH_COOKIE_DOMAIN=""
CLIENT_URLS="http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174"
# Base64-encoded random 32-byte AES-256-GCM key. Required for MFA enrollment
# and verification. Keep in a secret manager; never place it in a VITE_ value.
MFA_ENCRYPTION_KEY=""
PORT=5000
CLIENT_URL="http://localhost:5173"
# Verify this sender/domain in Resend before enabling recovery. Never use a placeholder.
PASSWORD_RESET_EMAIL_FROM=""
RESEND_API_KEY=""
# Optional temporary guard when PASSWORD_RESET_EMAIL_FROM=onboarding@resend.dev.
# Restricts password-reset requests to this one recipient in a disposable test release.
RESEND_TEST_RECIPIENT=""
# Test-only: prevents the bootstrap smoke test from opening a database connection.
SKIP_DB_CONNECT="false"
# Rate limits are process-local: deploy one API instance; counters reset on restart.
# A shared rate-limit store is required only before horizontal scaling to multiple API instances.
RATE_LIMIT_KEY_SECRET="replace-with-a-long-random-key"
# Base64-encoded 32-byte AES-256-GCM key. Required only for delivery orders; no plaintext fallback exists.
ORDER_DELIVERY_ENCRYPTION_KEY=""
# Server-only Paystack secret key. Configure the public HTTPS webhook at /api/v1/payments/paystack/webhook.
PAYSTACK_SECRET_KEY=""
# Optional server-controlled callback URL; clients cannot set it.
PAYSTACK_CALLBACK_URL=""
# Never use TRUST_PROXY=true. Set exactly one deployment-specific option.
TRUST_PROXY_HOPS=""
TRUST_PROXY_CIDRS=""
