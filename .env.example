DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Target: Supabase Postgres, reached by the Node API only. Use the project's
# exact session-pooler connection string on IPv4-only hosts. Do not switch a
# running test service until its existing data has been backed up and migrated.
# Server-only Supabase Storage credentials. Do not prefix with VITE_ or expose
# them to browsers. Buckets must be private; upload/preview routes stay gated
# until applicant authorization and malware scanning are connected.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Explicit project-ref guard for the private-bucket provisioning script.
SUPABASE_EXPECTED_PROJECT_REF=""
# Defaults to disabled. Do not enable document intake until a malware scanner,
# quarantine operations and incident response are ready in the test project.
HOSPITAL_EVIDENCE_INTAKE_ENABLED="false"
# Scanner polling is asynchronous and disabled until an internal ClamAV
# service has been tested. CLAMD_HOST must be a private, single-label Render
# hostname (or localhost); never use a public IP/FQDN for clamd's plain TCP.
EVIDENCE_SCANNER_ENABLED="false"
CLAMD_HOST=""
CLAMD_PORT="3310"
# Reviewer preview and decisions remain unavailable until the scanner and
# signed-link workflow pass live tests. Keep this false during setup.
HOSPITAL_EVIDENCE_REVIEW_ENABLED="false"
JWT_SECRET="replace-with-a-long-random-access-token-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-token-secret"
ACCESS_TOKEN_EXPIRY="15m"
JWT_ISSUER="sabi-identity"
JWT_AUDIENCE="sabi-api"
REFRESH_TOKEN_EXPIRY="7d"
# Phase 3 browser sessions. Production requires HTTPS and a common registrable
# domain for the API and all four app subdomains. Do not use a Vercel preview
# domain as AUTH_COOKIE_DOMAIN.
SESSION_DAYS="7"
SESSION_MAX_DAYS="90"
AUTH_COOKIE_DOMAIN=""
CLIENT_URLS="http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174"
# Base64-encoded random 32-byte AES-256-GCM key. Required for MFA enrollment
# and verification. Keep in a secret manager; never place it in a VITE_ value.
MFA_ENCRYPTION_KEY=""
PORT=5000
CLIENT_URL="http://localhost:5173"
# Verify this sender/domain in Resend before enabling recovery. Never use a placeholder.
PASSWORD_RESET_EMAIL_FROM=""
RESEND_API_KEY=""
# Optional temporary guard when PASSWORD_RESET_EMAIL_FROM=onboarding@resend.dev.
# Restricts password-reset requests to this one recipient in a disposable test release.
RESEND_TEST_RECIPIENT=""
# Test-only: prevents the bootstrap smoke test from opening a database connection.
SKIP_DB_CONNECT="false"
# Rate limits are process-local: deploy one API instance; counters reset on restart.
# A shared rate-limit store is required only before horizontal scaling to multiple API instances.
RATE_LIMIT_KEY_SECRET="replace-with-a-long-random-key"
# Base64-encoded 32-byte AES-256-GCM key. Required only for delivery orders; no plaintext fallback exists.
ORDER_DELIVERY_ENCRYPTION_KEY=""
# Server-only Paystack secret key. Configure the public HTTPS webhook at /api/v1/payments/paystack/webhook.
PAYSTACK_SECRET_KEY=""
# Optional server-controlled callback URL; clients cannot set it.
PAYSTACK_CALLBACK_URL=""
# Never use TRUST_PROXY=true. Set exactly one deployment-specific option.
TRUST_PROXY_HOPS=""
TRUST_PROXY_CIDRS=""

# Private medical-document storage (patient uploads). The API fails closed (503) until one
# provider is fully configured. Both are S3-compatible; values are server-only secrets.
#   supabase: uses the private "sabi-clinical-documents" bucket verified at startup.
#             Create S3 access keys in Supabase → Storage → S3 Connection.
#   r2:       Cloudflare R2.
DOCUMENT_STORAGE_PROVIDER=""
SUPABASE_S3_ENDPOINT=""          # https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=""            # the project's region, e.g. eu-west-2
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""
R2_REGION="auto"
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_SIGNED_URL_TTL_SECONDS=300
# HMAC secret shared with the malware-scanning worker that calls
# /api/v1/internal/document-scans/:id/result. Uploaded documents stay unreadable until scanned CLEAN.
DOCUMENT_SCAN_CALLBACK_SECRET=""
